# Sample configuration: truststrap.yaml in the working directory, $HOME/.truststrap or /etc/truststrap, or --config <path>.
# Precedence, lowest first: defaults, this file, TRUSTSTRAP_ environment, flags.

serve:
  # TCP listen address for the Noise_NK bootstrap server.
  # Environment: TRUSTSTRAP_SERVE_LISTEN
  # Flag:        --listen
  listen: ":8445"
