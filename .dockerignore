# Keep the build context small and reproducible.
#
# The root Dockerfile uses `COPY . .`, so anything not excluded is baked into
# the image: .git alone is usually larger than the source, and host-built
# binaries in bin/ can shadow what the image is supposed to compile itself.

# VCS and CI config — never needed inside the image
.git/
.gitignore
.gitattributes
.github/

# Host-built binaries and build output
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage artifacts, regenerated in the container
coverage/
*.test
*.out
*.prof

# A stray go.work silently changes module resolution inside the build
go.work
go.work.sum

# Module-fetch credentials are staged OUTSIDE the build context and handed in as
# a BuildKit secret (see the Dockerfiles). This is the second guard: a copy that
# ever lands in the tree must not be baked into a layer by `COPY . .`.
gomodauth
gomodauth.*
*.secret
vendor/

# Editor, agent and OS noise
.idea/
.vscode/
.claude/
.serena/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker files themselves
.dockerignore
Dockerfile

# BuildKit credential staging file (dependency-resolution.md §6). The canonical
# Gitea module-credential pattern mounts these variables via
# --mount=type=secret and the file is meant to live OUTSIDE the build context;
# this line is the second line of defence, so that a copy landing in the tree
# by accident can never be baked into a layer by a broad COPY.
gomodauth*
